# ==============================================================================
# HotelOS — Environment Configuration Example (.env.example)
#
# Target Architecture (HLD Aligned):
# - ONE PostgreSQL 16 server instance (hotelos-postgres)
# - ONE logical database (hotelos)
# - Dedicated schema per bounded context (reception, room_service, housekeeping, maintenance, dashboard_read)
#
# Copy this file to .env for local overrides: cp .env.example .env
# NOTE: .env is in .gitignore and must never contain production secrets in git.
# All default credentials below are for LOCAL DEVELOPMENT ONLY.
# ==============================================================================

# PostgreSQL Server Infrastructure (Local Development)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_DB=hotelos
POSTGRES_PORT=5434

# Host vs Container Port Mapping:
# - From Host machine: localhost:5434 (default on host to prevent port 5432 conflicts)
# - Inside Docker network: postgres:5432

# RabbitMQ (Local Development)
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Demo Auth
HOTELOS_AUTH_TOKEN=hotelos-demo-token

# ------------------------------------------------------------------------------
# Bounded Context Persistence: Reception Service
# ------------------------------------------------------------------------------
RECEPTION_SCHEMA=reception
RECEPTION_DB_USER=reception_user
RECEPTION_DB_PASSWORD=reception_dev_pass
# Host local URL:
RECEPTION_DB_URL=jdbc:postgresql://localhost:5434/hotelos?currentSchema=reception
# Docker internal network URL:
# RECEPTION_DB_URL=jdbc:postgresql://postgres:5432/hotelos?currentSchema=reception

# ------------------------------------------------------------------------------
# Bounded Context Persistence: Room Service
# ------------------------------------------------------------------------------
ROOM_SERVICE_SCHEMA=room_service
ROOM_SERVICE_DB_USER=room_service_user
ROOM_SERVICE_DB_PASSWORD=room_service_dev_pass
ROOM_SERVICE_DB_URL=jdbc:postgresql://localhost:5434/hotelos?currentSchema=room_service

# ------------------------------------------------------------------------------
# Bounded Context Persistence: Housekeeping Service
# ------------------------------------------------------------------------------
HOUSEKEEPING_SCHEMA=housekeeping
HOUSEKEEPING_DB_USER=housekeeping_user
HOUSEKEEPING_DB_PASSWORD=housekeeping_dev_pass
HOUSEKEEPING_DB_URL=jdbc:postgresql://localhost:5434/hotelos?currentSchema=housekeeping

# ------------------------------------------------------------------------------
# Bounded Context Persistence: Maintenance Service
# ------------------------------------------------------------------------------
MAINTENANCE_SCHEMA=maintenance
MAINTENANCE_DB_USER=maintenance_user
MAINTENANCE_DB_PASSWORD=maintenance_dev_pass
MAINTENANCE_DB_URL=jdbc:postgresql://localhost:5434/hotelos?currentSchema=maintenance

# ------------------------------------------------------------------------------
# Bounded Context Persistence: Dashboard Service (Read Models)
# ------------------------------------------------------------------------------
DASHBOARD_SCHEMA=dashboard_read
DASHBOARD_DB_USER=dashboard_user
DASHBOARD_DB_PASSWORD=dashboard_dev_pass
DASHBOARD_DB_URL=jdbc:postgresql://localhost:5434/hotelos?currentSchema=dashboard_read
